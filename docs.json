{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dreamscale",
  "description": "Run robot foundation models on cloud GPUs from the CLI or a few lines of Python.",
  "colors": {
    "primary": "#16181A",
    "light": "#F7F8F7",
    "dark": "#73777A"
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 600
    }
  },
  "favicon": "/logo/dreamscale-mark.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "variables": {
    "sdkVersion": "0.1.0a232",
    "dashboardUrl": "https://app.dreamscalelabs.com",
    "docsUrl": "https://docs.dreamscalelabs.com",
    "supportEmail": "team@dreamscalelabs.com"
  },
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "models"
        ]
      },
      {
        "group": "Run on your robot",
        "pages": [
          "robots/yam",
          "robots/so101",
          "robots/ur",
          "python"
        ]
      },
      {
        "group": "Improve your model",
        "pages": [
          "training",
          "deployments"
        ]
      },
      {
        "group": "References",
        "pages": [
          "reference/cli",
          "reference/sdk"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "troubleshooting"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:team@dreamscalelabs.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.dreamscalelabs.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "markdown": {
    "instructions": [
      "Treat the Dreamscale CLI and Python SDK as the supported public integration surfaces.",
      "Prefer `dreamscale run <robot>` for supported robots and `dreamscale.connect(model)` with `predict` or `next_action` in Python.",
      "Do not infer or recommend internal control-plane APIs."
    ]
  },
  "redirects": [
    {
      "source": "/installation",
      "destination": "/"
    },
    {
      "source": "/quickstart",
      "destination": "/"
    },
    {
      "source": "/guides/so101",
      "destination": "/robots/so101"
    },
    {
      "source": "/golden-path",
      "destination": "/robots/so101"
    },
    {
      "source": "/docs/golden-path",
      "destination": "/robots/so101"
    },
    {
      "source": "/guides/browser-sim",
      "destination": "/"
    },
    {
      "source": "/guides/franka",
      "destination": "/models"
    },
    {
      "source": "/guides/deployments",
      "destination": "/deployments"
    },
    {
      "source": "/fine-tuning/deployments",
      "destination": "/deployments"
    },
    {
      "source": "/guides/inspect-robots",
      "destination": "/"
    },
    {
      "source": "/integrations/inspect-robots",
      "destination": "/"
    },
    {
      "source": "/integrations/hud",
      "destination": "/"
    },
    {
      "source": "/sdk/overview",
      "destination": "/python"
    },
    {
      "source": "/python/run-a-policy",
      "destination": "/python"
    },
    {
      "source": "/sdk/model-contracts",
      "destination": "/models"
    },
    {
      "source": "/python/models",
      "destination": "/models"
    },
    {
      "source": "/reference/troubleshooting",
      "destination": "/troubleshooting"
    }
  ]
}
