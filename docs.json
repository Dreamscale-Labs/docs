{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dropbear",
  "description": "Cloud robot policy inference through a small Python SDK and CLI.",
  "colors": {
    "primary": "#16181A",
    "light": "#F7F8F7",
    "dark": "#73777A"
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 600
    }
  },
  "favicon": "/logo/dropbear-mark.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "variables": {
    "sdkVersion": "0.1.0a9",
    "dashboardUrl": "https://dropbear.dreamscalelabs.com",
    "docsUrl": "https://docs.dropbear.dreamscalelabs.com",
    "supportEmail": "team@dreamscalelabs.com"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "installation"
        ]
      },
      {
        "group": "Build with Python",
        "pages": [
          "sdk/overview",
          "sdk/model-contracts"
        ]
      },
      {
        "group": "Robot guides",
        "pages": [
          "guides/so101",
          "guides/franka",
          "guides/inspect-robots"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "troubleshooting"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:team@dreamscalelabs.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dropbear.dreamscalelabs.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "markdown": {
    "instructions": [
      "Treat the Dropbear Python SDK and CLI as the supported public integration surfaces.",
      "Prefer context-managed sessions and model-specific observation helpers.",
      "Do not infer or recommend internal control-plane APIs."
    ]
  },
  "redirects": [
    {
      "source": "/golden-path",
      "destination": "/guides/so101"
    },
    {
      "source": "/docs/golden-path",
      "destination": "/guides/so101"
    },
    {
      "source": "/guides/browser-sim",
      "destination": "/quickstart"
    }
  ]
}
