{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dreamscale",
  "description": "Run robot foundation models in the cloud from a CLI or a small Python SDK.",
  "colors": {
    "primary": "#16181A",
    "light": "#F7F8F7",
    "dark": "#73777A"
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 600
    }
  },
  "favicon": "/logo/dreamscale-mark.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "variables": {
    "sdkVersion": "0.1.0a101",
    "dashboardUrl": "https://app.dreamscalelabs.com",
    "docsUrl": "https://docs.dreamscalelabs.com",
    "supportEmail": "team@dreamscalelabs.com"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Robots",
        "pages": [
          "robots/so101",
          "robots/yam"
        ]
      },
      {
        "group": "Build with Python",
        "pages": [
          "python/run-a-policy",
          "python/models"
        ]
      },
      {
        "group": "Fine-tuning",
        "pages": [
          "fine-tuning/deployments"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/sdk",
          "reference/troubleshooting"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/inspect-robots",
          "integrations/hud"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:team@dreamscalelabs.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.dreamscalelabs.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "markdown": {
    "instructions": [
      "Treat the Dreamscale CLI and Python SDK as the supported public integration surfaces.",
      "Prefer `dreamscale run <robot>` for supported robots and `dreamscale.connect()` with a context manager in Python.",
      "Do not infer or recommend internal control-plane APIs."
    ]
  },
  "redirects": [
    {
      "source": "/installation",
      "destination": "/quickstart"
    },
    {
      "source": "/guides/so101",
      "destination": "/robots/so101"
    },
    {
      "source": "/golden-path",
      "destination": "/robots/so101"
    },
    {
      "source": "/docs/golden-path",
      "destination": "/robots/so101"
    },
    {
      "source": "/guides/browser-sim",
      "destination": "/quickstart"
    },
    {
      "source": "/guides/franka",
      "destination": "/python/models"
    },
    {
      "source": "/guides/deployments",
      "destination": "/fine-tuning/deployments"
    },
    {
      "source": "/guides/inspect-robots",
      "destination": "/integrations/inspect-robots"
    },
    {
      "source": "/sdk/overview",
      "destination": "/python/run-a-policy"
    },
    {
      "source": "/sdk/model-contracts",
      "destination": "/python/models"
    },
    {
      "source": "/troubleshooting",
      "destination": "/reference/troubleshooting"
    }
  ]
}
